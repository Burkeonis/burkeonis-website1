# Firebase web configuration is public configuration, not an Admin credential.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-project-id
VITE_FIREBASE_APP_ID=replace-with-app-id
VITE_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# No Gemini, Stripe, Cloudflare, or Firebase Admin secrets belong here.
